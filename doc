#!/bin/bash

read -r -d '' usage << EOF
    ____  ____  ______
   / __ \/ __ \/ ____/
  / / / / / / / /     
 / /_/ / /_/ / /___   
/_____/\____/\____/   

Documentation, Of Course!

doc -c [name]               -  Create new host info card.
doc -u [name] [field] [x]   -  Update host info.
doc -u [name] auto          -  Attempt to find hostname and OS automatically.
doc [name] [property]       -  Print property for a particular host.  
doc [name] [user|pass]      -  Prints most recently added username or password.  
doc [name] [user|pass] [n]  -  Prints nth username or password.
doc [name(s)]               -  Print info cards for the provided hosts.
doc all                     -  Print all host cards at once!
doc all [text]              -  Print host cards whose names or IPs include the provided text.
doc list                    -  List the names and IPs of all hosts.
doc list names              -  List the names of all hosts.
doc list ips                -  List the IPs of all hosts.
doc list -p [port]          -  List the IPs of all hosts with a certain port.
doc clear                   -  Clear the card cache. Useful if editing host JSON directly.
doc target [name]           -  Define a particular host as the current target for "doc x".
doc x [...]                 -  Useful for scripting. If another script uses "doc x", you can set targets for it dynamically.
EOF

# Settings
use_gpg=0 # Store passwords GPG-encrypted

IFS=$'\n'
here="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
hosts="$here/hosts"
templates="$here/templates"
cache="$here/cache"

if ! [[ -d "$hosts" ]]; then
  mkdir "$hosts"
fi

if ! [[ -d "$cache" ]]; then
  mkdir "$cache"
fi

create=''
update=''
delete=''

upper() {
  text=$(</dev/stdin)
  echo "$text" | tr '[:lower:]' '[:upper:]'
}

lower() {
  text=$(</dev/stdin)
  echo "$text" | tr '[:upper:]' '[:lower:]'
}

bold() {
  bld=$(tput bold)
  nrm=$(tput sgr0)
  
  while IFS= read -r x; do
    echo "${bld}$x${nrm}"
  done <<< $(</dev/stdin)
}

unbold() {
  text=$(</dev/stdin)
  echo "$text" | sed -E $'s/\x1B(\[[0-9;]*[a-zA-Z]|\([A-Za-z])//g'
}

maxc() {
  cat | awk '{ if (length($0) > max) max = length($0) } END { print max }'
}

color() {
  declare -A clrs
  clrs[y]='\033[33m'
  clrs[r]='\033[31m'
  text=$(</dev/stdin)
  clr="${clrs[$1]}"
  nrm=$(tput sgr0)
  echo -e "${clr}$text${nrm}"
}

multiprint() {
  perl -e "print \"$1\" x $2"
  echo
}

page() {
  if [[ -n "$2" ]]; then
    input=$(cat)
    pg="$2"
    pgsz="$1"
    max=$(echo "$input" | wc -l)
    max2=$((pg * pgsz))
  
    if [[ $max -ge $max2 ]]; then
      echo "$input" | head -n "$max2" | tail -n "$pgsz"
    elif [[ $((max2 - max)) -lt $pgsz ]]; then
      echo "$input" | tail -n $((max % pgsz))
    fi
  else
    head -n $(("$1" * 40)) | tail -n 40
  fi
}

mkbox() {
read -r -d '' pytxt << EOF
import sys

def bold(text):
  return f"\\033[1m{text}\\033[0m"

def mkbox(val, style, line):
  vlen = len(val)
  cols = vlen + 2

  if style == '-b':
    val = bold(val)
    h = '━'
    v = '┃'
    lt = '┣'
    rt = '┫'
    ut = '┳'
    dt = '┻'
    ct = '╋'
    c1 = '┏'
    c2 = '┓'
    c3 = '┗'
    c4 = '┛'
  else:
    h = '─'
    v = '│'
    lt = '├'
    rt = '┤'
    ut = '┬'
    dt = '┴'
    ct = '┼'
    c1 = '┌'
    c2 = '┐'
    c3 = '└'
    c4 = '┘'

  sect = h * cols
  if cols % 2 == 0:
    line_s = h * int(cols / 2 - 1) + ut + h * int(cols / 2)
  else:
    line_s = h * int(cols / 2) + ut + h * int(cols / 2)

  if line == 'n':
    top = f"{c1}{sect}{c2}"
    mid = f"\\n{v} {val} {v}"
    bot = f"\\n{c3}{sect}{c4}"
  elif line == 'e':
    top = f"{c1}{sect}{c2}"
    mid = f"\\n{v} {val} {v}"
    bot = f"\\n{c3}{sect}{c4}"
  elif line == 's':
    top = f"{c1}{sect}{c2}"
    mid = f"\\n{v} {val} {v}"
    bot = f"\\n{c3}{line_s}{c4}"
  elif line == 'w':
    top = f"{c1}{sect}{c2}"
    mid = f"\\n{v} {val} {v}"
    bot = f"\\n{c3}{sect}{c4}"
  else:
    top = f"{c1}{sect}{c2}"
    mid = f"\\n{v} {val} {v}"
    bot = f"\\n{c3}{sect}{c4}"

  return f"{top}{mid}{bot}"

if sys.argv[1] == '-b':
  print(mkbox(sys.argv[2], '-b', ''))
elif sys.argv[1] == '-h':
  print(mkbox(sys.argv[3], '', sys.argv[2]))
else:
  print(mkbox(sys.argv[1], '', ''))
EOF

  python3 -c "$pytxt" $@
}

pad() {
  max="$1"
  input=$(</dev/stdin)
  size=$(echo "$input" | wc -l)
  diff=$((max - size))
  
  if [[ "$diff" -gt 0 ]]; then
    echo "$input"
    for x in $(seq 1 $diff); do
      echo ' '
    done
  else
    echo "$input"
  fi
}

multidoc() {
  max=0
  hosts=''
  notes=''
  
  hosts="$1"
  first=$(echo "$hosts" | head -n 1)
  notes=$(doc "$first" | sd '━' ';')
  
  for x in $hosts; do
    len=$(doc "$x" | wc -l)
    if [[ "$len" -gt "$max" ]]; then
      max="$len"
    fi
  done
  
  notes=$(echo "$notes" | pad "$max")
  hosts=$(echo "$hosts" | sed 1d)
  
  for x in $hosts; do
    notes=$(paste <(echo "$notes" | unbold | expand -t 4 | sd '$' '​') <(doc "$x" | sd '━' ';' | unbold | pad "$max") | column -t -s '​' | head -n -1)
  done

  header=$(echo "$notes" | sed -n 1,3p)
  line=$(echo "$header" | sed -n 2p)
  line2=$(echo $line | bold)
  header=$(echo "$header" | sd "$line" "$line2" | sd ';' '━') 
  body=$(echo "$notes" | sed 1,3d)

  for x in $(echo "$body" | rg -o '[A-Z\-]+:'); do
    body=$(echo "$body" | sd "$x" "$(echo $x | bold)")
  done

  for x in $(echo "$body" | rg -o '\[.\]'); do
    if echo "$x" | rg -q '\?'; then
      new=$(echo '[?]' | bold | color y)
      body=$(echo "$body" | sd "\[\?\]" "$new")
    elif echo "$x" | rg -q '!'; then
      new=$(echo '[!]' | bold | color r)
      body=$(echo "$body" | sd "\[!\]" "$new")
    else
      mid=$(echo "$x" | cut -c 2)
      new=$(echo "$x" | bold)
      body=$(echo "$body" | sd "\[$mid\]" "$new")
    fi
  done

  echo "$header"
  echo "$body"
}

while getopts "c:u:" opt; do
  case ${opt} in
    c) create="$OPTARG" ;;
    u) update="$OPTARG" ;;
  esac
done 2>/dev/null

if [[ -z "$1" ]]; then
  echo "    $usage"; echo; exit 1
fi

if [[ -n "$create" ]]; then
  create=$(echo "$create" | lower)
  cp "$templates/host.json" "$hosts/$create.json"
  new=$(jq -r --argjson x "\"$create\"" '.name = $x' "$hosts/$create.json")
  echo "$new" > "$hosts/$create.json"
  rm "$cache/$create" 2>/dev/null
  doc "$create" > /dev/null

elif [[ -n "$update" ]]; then
  update=$(echo "$update" | lower)
  if [[ "$3" == 'users' ]]; then
    if [[ -n "$5" ]]; then
      if [[ "$use_gpg" -eq 0 ]]; then
        user=$(jq -r --arg name "$4" --arg pass "$5" '.name = $name | .pass = $pass' "$templates/user.json")
      else
        pwnm="doc/$update/$4"
        user=$(jq -r --arg name "$4" --arg pass "$pwnm" '.name = $name | .pass = $pass' "$templates/user.json")
        echo "$5" | pass insert -e "$pwnm" > /dev/null
      fi
    else
      user=$(jq -r --arg name "$4" '.name = $name' "$templates/user.json")
    fi
    new=$(jq -r --argjson user "$user" --arg name "$4" \
     'if any(.users[]; .name == $name) then
        .users |= map(if .name == $name then $user else . end)
      else
        .users += [$user]
      end' "$hosts/$update.json")
  elif [[ "$3" == 'ports' ]]; then
    if [[ -f "$4" ]]; then
      ports=$(cat "$4" | rg -o '[0-9]+/' | tr -d '/')
      for port in $ports; do
        if ! doc "$update" ports | jq -r .[].number | rg -q "^$port$"; then doc -u "$update" ports "$port"; fi
      done
      exit
    elif [[ "$4" == '5985' ]]; then
      service='WINRM'
    else
      service=$(getent services "$4" | awk '{print $1}' | upper)
      if [[ -z "$service" ]]; then
        service='???'
      elif [[ "$4" == '80' ]]; then
        host=$(cat "$hosts/$update.json")
        if [[ $(echo "$host" | jq -r .url) == '???' ]]; then
          doc -u "$update" url http://$(echo "$host" | jq -r .ip)
        fi
      elif [[ "$4" == '443' ]]; then
        host=$(cat "$hosts/$update.json")
        if [[ $(echo "$host" | jq -r .url) == '???' ]]; then
          doc -u "$update" url https://$(echo "$host" | jq -r .ip)
        fi
      fi
    fi
    port=$(jq -r --arg number "$4" --arg service "$service" '.number = $number | .service = $service' "$templates/port.json")
    new=$(jq -r --argjson x "$port" '.ports += [$x]' "$hosts/$update.json")
  elif [[ "$3" == 'auto' ]]; then 
    ip=$(cat "$hosts/$update.json" | jq -r .ip)
    ports=$(cat "$hosts/$update.json" | jq -r .ports[].number)
    if echo "$ports" | rg -q '^445$'; then
      smb=$(nxc smb "$ip" -u '' -p '')
      name=$(echo "$smb" | field 4 | head -n 1)
      os=$(echo "$smb" | rg -o '\[\*\] [^ ]+ [^ ]+ [^ ]+' | sd '\[\*\] ' '')
    elif echo "$ports" | rg -q '^1443$'; then
      name=$(mssqlclient.py :@"$ip" | rg '\[\-\]' | sd '.*\(' '' | sd '\).*' '')
      os='Windows'
    fi
    doc -u "$update" os "$os"
    doc -u "$update" name "$name"
    exit
  elif [[ "$3" == 'name' ]]; then
    name=$(echo "$4" | lower)
    mv "$hosts/$update.json" "$hosts/$name.json"
    if [[ $(cat "$hosts/target") == "$update" ]]; then
      doc target "$name"
    fi
    rm "$cache/$update" 2>/dev/null
    update="$name"
    new=$(jq -r --argjson x "\"$4\"" ".$3 = \$x" "$hosts/$update.json")
  elif [[ "$3" == 'todo' ]]; then
    todo=$(cat "$hosts/$update.json" | jq -r .todo)
    if [[ "$todo" != '[]' ]]; then
      states=$(echo "$todo" | jq -r .[].state)
      items=$(echo "$todo" | jq -r .[].item)
      todo=$(paste -d ' ' <(echo "$states") <(echo "$items"))
    else
      todo=''
    fi
    temp=$(mktemp)
    echo "$todo" > $temp
    $EDITOR $temp
    todo='[]'
    while IFS= read -r x; do
      state=$(echo "$x" | rg -o '[ ]*\[.\]')
      item=$(echo "$x" | rg '\[.\]' | sd '[ ]*\[.\] ' '')
      new=$(jq -r --argjson x "\"$item\"" '.item = $x' "$templates/todo.json")
      new=$(echo "$new" | jq -r --argjson x "\"$state\"" '.state = $x' | jq -c)
      todo=$(echo "$todo" | sd ']$' "$new,]")
    done <<< $(cat $temp | rg '[ ]*\[.\]')
    rm $temp
    todo=$(echo "$todo" | sd ',]$' ']')
    new=$(jq -r --argjson x "$todo" ".todo = \$x" "$hosts/$update.json")
  else
    new=$(jq -r --argjson x "\"$4\"" ".$3 = \$x" "$hosts/$update.json")
  fi

  echo "$new" > "$hosts/$update.json"
  rm "$cache/$update" 2>/dev/null
  doc "$update" > /dev/null

elif [[ -f "$hosts/$1.json" ]]; then
  host=$(cat "$hosts/$1.json")
  m=1
  for x in $@; do
    if ! [[ -f "$hosts/$x.json" ]]; then
      m=0
    fi
  done
  if [[ "$m" -eq 1 ]] && [[ $# -gt 1 ]]; then
    multidoc "$(echo $@ | tr ' ' '\n')"
  elif [[ $# -eq 2 ]] && [[ $(echo "$host" | jq -r ".$2") != 'null' ]]; then
    echo "$host" | jq -r ".$2"
  elif [[ "$2" == 'user' ]]; then
    if [[ -z "$3" ]]; then
      echo "$host" | jq -r .users[].name | tail -n 1
    else
      num="$3"
      ((--num))
      echo "$host" | jq -r .users[$num].name
    fi
  elif [[ "$2" == 'pass' ]]; then
    if [[ -z "$3" ]]; then
      if [[ "$use_gpg" -eq 0 ]]; then
        echo "$host" | jq -r .users[].pass | tail -n 1
      else
        pwnm=$(echo "$host" | jq -r .users[].pass | tail -n 1)
        pass "$pwnm"
      fi
    else
      if [[ "$use_gpg" -eq 0 ]]; then
        num="$3"
        ((--num))
        echo "$host" | jq -r .users[$num].pass
      else
        num="$3"
        ((--num))
        pwnm=$(echo "$host" | jq -r .users[$num].pass)
        pass "$pwnm"
      fi
    fi
  elif [[ $# -eq 1 ]]; then
    if ! [[ -f "$cache/$1" ]]; then
      output=$(
        mkbox -b $(echo $1 | upper)
        echo "$(echo OS: | bold)  $(echo "$host" | jq -r .os)"
        echo "$(echo IP: | bold)  $(echo "$host" | jq -r .ip)"
        echo "$(echo URL: | bold) $(echo "$host" | jq -r .url)"
        echo
        ports=$(echo "$host" | jq -r .ports)
        if [[ "$ports" != '[]' ]]; then
          portnums=$(echo "$ports" | jq -r .[].number)
          portnames=$(echo "$ports" | jq -r .[].service)
          echo PORTS: | bold
          glue -s '  -  ' "$portnums" "$portnames"
          echo
        fi
        users=$(echo "$host" | jq -r .users)
        if [[ "$users" != '[]' ]]; then
          names=$(echo "$users" | jq -r .[].name)
          passes=$(echo "$users" | jq -r .[].pass)
          echo USERS: | bold
          if [[ "$use_gpg" -eq 0 ]]; then
            glue -s '  -  ' "$names" "$passes"
            echo
          else
            pwnms="$passes"
            passes=$(for x in $pwnms; do pass "$x"; done)
            glue -s '  -  ' "$names" "$passes"
            echo
          fi
        fi
        todo=$(echo "$host" | jq -r .todo)
        if [[ "$todo" != '[]' ]]; then
          states=$(echo $todo | jq -r .[].state | bold)
          items=$(echo $todo | jq -r .[].item)
          lines=$(echo "$states" | wc -l)
          echo TO-DO: | bold
          for x in $(seq 1 $lines); do
            state=$(echo "$states" | sed -n "$x"p)
            item=$(echo "$items" | sed -n "$x"p)
            if echo "$state" | rg -q '\?'; then state=$(echo "$state" | color y); fi
            if echo "$state" | rg -q '!'; then state=$(echo "$state" | color r); fi
            echo "$state $item"
          done
        fi
      )
      echo "$output" > "$cache/$1"
    fi
    cat "$cache/$1"
  fi
elif [[ "$1" == 'all' ]]; then
  n=2
  cols=$(tput cols)
  if [[ -n "$2" ]]; then
    list=$(doc list | rg "$2" | cut -d '-' -f 1 | tr -d ' ')
  else
    list=$(doc list | cut -d '-' -f 1 | tr -d ' ')
  fi
  count=$(echo "$list" | wc -l)
  if [[ "$count" -eq 1 ]]; then
    doc "$list"
    exit
  fi
  while [[ -n "$list" ]]; do
    chunk=$(echo "$list" | head -n "$n" )
    next=$(multidoc "$chunk")
    last=''
    nlen=$(echo "$next" | unbold | maxc) 
    while [[ "$nlen" -lt "$cols" && "$n" -lt "$count" ]]; do
      ((++n))
      chunk=$(echo "$list" | head -n "$n")
      last="$next"
      next=$(multidoc "$chunk")
      nlen=$(echo "$next" | unbold | maxc)
    done
    if [[ "$nlen" -gt "$cols" ]]; then
      next="$last"
    fi
    echo "$next"
    echo
    list=$(echo "$list" | sed 1,"$n"d)
    count=$(echo "$list" | wc -l)
  done
elif [[ "$1" == 'list' ]]; then
  files=$(ls "$hosts" | rg '\.json$')
  names=$(echo "$files" | sd '.json$' '')
  if [[ -z "$names" ]]; then
    echo 'No hosts found.'
    exit 1
  fi
  ips=$(cat "$hosts"/*.json | jq -r .ip)
  if [[ "$2" == 'names' ]]; then
    echo "$names"
  elif [[ "$2" == 'ips' ]]; then
    echo "$ips"
  elif [[ "$2" == '-p' ]]; then
    while IFS= read -r x; do
      host=$(cat "$hosts/$x")
      if echo "$host" | jq -r '.ports[].number' | rg -q "^$3$"; then
        echo "$host" | jq -r '.ip'
      fi
    done <<< $(echo "$files")
  else
    glue -s '  -  ' "$names" "$ips"
  fi
elif [[ "$1" == 'target' ]]; then
  echo "$2" > "$hosts/target"
elif [[ "$1" == 'x' ]]; then
  doc $(cat "$hosts/target") "${@:2}"
elif [[ "$1" == 'clear' ]]; then
  rm "$cache"/*
else
  echo "    $usage"; echo; exit 1
fi
